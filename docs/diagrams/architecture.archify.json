 "cards": [
  {
   "dot": "emerald",
   "title": "Core Agents",
   "items": [
    "Rider Advocate and Driver Advocate build Submissions in parallel; neither sees the other's",
    "The Judge accepts or rejects each argument and cites evidence and Policy Clauses",
    "The Judge never sees History; a code step applies it after the outcome is fixed"
   ]
  },
  {
   "dot": "violet",
   "title": "Supporting Agents",
   "items": [
    "Each is a layer behind a console switch; all off is the three Core Agents alone",
    "Escalation has no checkbox: it is on for every run",
    "A Ruling below 0.7 Confidence, or with a review trigger, goes to a Human Reviewer"
   ]
  },
  {
   "dot": "amber",
   "title": "Simulated",
   "items": [
    "Trips, chat, fares, photos, policy and past Rulings are mock data",
    "Outcomes are shown on screen, not sent to anyone",
    "A payment is only ever recommended, never executed"
   ]
  },
  {
   "dot": "slate",
   "title": "One store, one log",
   "items": [
    "Agents read and write the Case store; none messages another",
    "Evidence is sealed before either advocate argues",
    "Every write is an event in the Communication Log"
   ]
  }
 ]
