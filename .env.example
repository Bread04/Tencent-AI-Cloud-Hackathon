# Copy to .env and fill in. .env is git-ignored; never commit a real key.
# These are read from the environment (load them in your shell or your process manager).

# stub (default): scripted replies, no network.  openai_compatible: a real model.
MODEL_PROVIDER=stub

# Needed only when MODEL_PROVIDER=openai_compatible.
# The provider and model are not confirmed yet (ticket 08). Use any OpenAI-compatible chat endpoint.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# Optional: seconds before a model call counts as failed (default 30).
# MODEL_TIMEOUT_SECONDS=30
