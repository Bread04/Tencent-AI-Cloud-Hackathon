# Copy to .env and fill in. .env is git-ignored; never commit a real key.
# The demo app and scripts/try_model.py read this file; a real environment variable overrides it.
# Tests ignore it and always use the scripted stub.

# stub (default): scripted replies, no network.  openai_compatible: a real model.
MODEL_PROVIDER=stub

# Needed only when MODEL_PROVIDER=openai_compatible.
# The provider and model are not confirmed yet (ticket 08). Use any OpenAI-compatible chat endpoint.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# Optional: json_object for providers that reject a JSON schema (put the schema in the prompt instead).
# MODEL_STRUCTURED_OUTPUT=json_schema

# Optional: seconds before a model call counts as failed (default 30).
# MODEL_TIMEOUT_SECONDS=120

# Optional: how many times a call waits out the provider's rate limit before it fails (default 6).
# MODEL_RATE_LIMIT_RETRIES=6
